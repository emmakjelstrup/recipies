# ---------------------------------------------------------------
# Secrets and local environment (never commit these)
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
application-local-secrets.yml
application-secrets.yml

# ---------------------------------------------------------------
# Backend: Java / Maven / Spring Boot
# ---------------------------------------------------------------
backend/target/
**/target/
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar.bak
*.class
*.log
*.jar
*.war
*.ear
!**/.mvn/wrapper/maven-wrapper.jar
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties

# Spring Boot
spring-shell.log
HELP.md

# ---------------------------------------------------------------
# Frontend: Node / Vite / React
# ---------------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
frontend/coverage/
frontend/.vite/
*.tsbuildinfo
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Tests: Playwright / Vitest outputs
playwright-report/
test-results/
blob-report/
playwright/.cache/
coverage/

# NOTE: the generated API client (frontend/src/api/generated) and
# docs/openapi.json are intentionally NOT ignored. CI checks that they
# are up to date with `git diff --exit-code`.

