# Docker / local infrastructure data
# ---------------------------------------------------------------
infra/data/
infra/postgres-data/
docker-compose.override.yml
*.local.yml

# Local uploads and generated files (imported recipe photos, etc.)
uploads/
storage/

# ---------------------------------------------------------------
